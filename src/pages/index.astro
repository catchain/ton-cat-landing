---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
---

<Layout>
  <Header />
  <main class="landing">
    <div class="landing-pattern" aria-hidden="true">
      <img src="/images/pattern.svg" alt="" class="landing-pattern-img" />
    </div>
    <Hero />
    <Projects />
  </main>
</Layout>

<style>
  :global(html, body) {
    height: 100%;
    overflow: hidden;
  }

  .landing {
    position: relative;
    box-sizing: border-box;
    height: 100dvh;
    display: grid;
    grid-template-rows: 1fr 1fr;
    padding-top: 66px;
    overflow: hidden;
  }

  .landing-pattern {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 50%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 75%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 75%, transparent 100%);
  }

  .landing-pattern-img {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .landing :global(.hero) {
    position: relative;
    z-index: 1;
    min-height: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 32px;
  }

  .landing :global(.projects) {
    position: relative;
    z-index: 1;
    min-height: 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    width: 100%;
    padding: 32px 0 48px;
  }

  @media (max-width: 768px) {
    .landing {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 28px;
      padding-top: 60px;
      padding-bottom: 32px;
    }

    .landing :global(.hero) {
      flex: 0 0 auto;
      align-items: center;
      padding-bottom: 0;
    }

    .landing :global(.projects) {
      flex: 0 0 auto;
      align-items: center;
      padding: 0;
    }
  }
</style>

---

<section class="news" id="news">
  <div class="news-bg">
    <img src="/images/news-bg.png" alt="" aria-hidden="true" />
  </div>
  <div class="news-columns">
    {columns.map((col) => (
      <div class="news-column">
        {col.map((item) => (
          <article class="news-card">
            <div class="news-card-header">
              <img src={item.avatar} alt="" class="news-avatar" width="32" height="32" />
              <div class="news-card-meta">
                <span class="news-source">{item.source}</span>
                {item.handleLink ? (
                  <a href={item.handleLink} class="news-handle" target="_blank">{item.handle}</a>
                ) : (
                  <span class="news-handle">{item.handle}</span>
                )}
              </div>
            </div>
            <div class="news-card-divider"></div>
            <p class="news-text">{item.text}</p>
            <span class="news-date">{item.date}</span>
          </article>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  .news {
    position: relative;
    padding: 80px 0 0;
    overflow: hidden;
  }

  .news-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .news-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .news-columns {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 24px;
    padding: 0 max(24px, calc((100vw - 1728px) / 2 + 216px));
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 80px;
  }

  .news-columns::-webkit-scrollbar {
    display: none;
  }

  .news-column {
    flex-shrink: 0;
    width: 408px;
    background: #fff;
    border-radius: var(--radius-md);
    overflow: hidden;
    max-height: 494px;
    overflow-y: hidden;
  }

  .news-card {
    padding: 24px;
  }

  .news-card + .news-card {
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .news-card-header {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 12px;
  }

  .news-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .news-card-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .news-source {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: -0.22px;
  }

  .news-handle {
    font-size: 12px;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.3);
  }

  a.news-handle:hover {
    opacity: 0.7;
  }

  .news-card-divider {
    display: none;
  }

  .news-text {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.196px;
    line-height: 1.57;
    margin-bottom: 12px;
    white-space: pre-line;
  }

  .news-date {
    font-size: 12px;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.3);
    line-height: 1.33;
  }

  @media (max-width: 1200px) {
    .news-column {
      width: 340px;
    }

    .news-columns {
      padding: 0 24px;
      padding-bottom: 60px;
    }
  }

  @media (max-width: 768px) {
    .news {
      padding: 56px 0 0;
    }

    .news-column {
      width: 300px;
      max-height: 420px;
    }

    .news-columns {
      padding: 0 16px;
      padding-bottom: 48px;
      gap: 16px;
    }
  }

  @media (max-width: 480px) {
    .news-column {
      width: 270px;
    }
  }
</style>

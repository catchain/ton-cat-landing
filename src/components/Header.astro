---
import LogoIcon from './LogoIcon.astro';

const navLinks = [
  { label: 'Mission', href: '#mission', hidden: true },
  { label: 'Projects', href: '#staking', hidden: true },
  { label: 'News Feed', href: '#news', hidden: true },
];

const externalLinks = [
  { label: 'Github', href: 'https://github.com/catchain' },
  { label: 'Telegram', href: 'https://t.me/catchain' },
];
---

<header class="header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="CAT">
      <LogoIcon size={34} />
    </a>

    <nav class="nav">
      {navLinks.map((link) => (
        <a href={link.href} class:list={['nav-link', { 'nav-link-hidden': link.hidden }]}>{link.label}</a>
      ))}
      {externalLinks.map((link) => (
        <a href={link.href} class="nav-link nav-link-external">
          {link.label}
          <img src="/icons/arrow-up-right.svg" alt="" class="arrow-icon" width="9" height="9" />
        </a>
      ))}
    </nav>
  </div>
</header>

<script is:inline>
  (function() {
    document.addEventListener('DOMContentLoaded', function() {
      var header = document.querySelector('.header');
      if (header) {
        window.addEventListener('scroll', function() {
          header.classList.toggle('scrolled', window.scrollY > 20);
        }, { passive: true });
      }
    });
  })();
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 16px 0;
    transition: background 0.25s, backdrop-filter 0.25s;
  }

  .header.scrolled {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 20px;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
  }

  .logo:hover {
    opacity: 1;
  }

  .logo :global(.logo-icon) {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    color: var(--color-text);
    transform: translateY(-3px);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .nav-link {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text);
    transition: opacity 0.2s;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 3px;
  }

  .nav-link-external {
    align-items: center;
  }

  .nav-link:hover {
    opacity: 0.7;
  }

  .nav-link-hidden {
    display: none;
  }

  .arrow-icon {
    width: 9px;
    height: 9px;
    flex-shrink: 0;
    display: block;
    opacity: 0.3;
    transform: translateY(0);
  }

  @media (max-width: 768px) {
    .header-inner {
      gap: 16px;
    }

    .nav {
      gap: 20px;
    }

    .nav-link {
      font-size: 13px;
    }
  }
</style>
